{
  "name": "home-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --hot src/server/core/index.ts",
    "dev:log": "NODE_ENV=development SENTINEL_MODEL_TRACE=1 bun --hot src/server/core/index.ts ",
    "start": "NODE_ENV=production bun src/server/core/index.ts",
    "build": "bun build.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "monitor": "NODE_ENV=development bun --watch src/server/core/monitor.ts",
    "python-services:setup": "src/server/python_services/bin/setup",
    "python-services:start": "src/server/python_services/bin/manage start all",
    "python-services:stop": "src/server/python_services/bin/manage stop all",
    "python-services:status": "src/server/python_services/bin/manage status all",
    "test": "bun run test:report",
    "test:perf": "NODE_ENV=test bun test src/server/test/*.test.ts --timeout 60000",
    "test:report": "NODE_ENV=test bun run src/server/test/generate_report.ts",
    "terminate_media": "bun run src/server/scripts/terminate_media.ts",
    "register": "bun run src/server/scripts/register_face.ts",
    "codegraph:index": "npx -y @colbymchenry/codegraph index .",
    "codegraph:sync": "npx -y @colbymchenry/codegraph sync .",
    "codegraph:status": "npx -y @colbymchenry/codegraph status ."
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/human": "^3.3.6",
    "ai": "^3.4.33",
    "bun-plugin-tailwind": "^0.1.2",
    "ollama-ai-provider": "^1.2.0",
    "pipe2jpeg": "^0.5.0",
    "react": "^19",
    "react-dom": "^19",
    "systeminformation": "^5.31.7",
    "tw-animate-css": "^1.4.0",
    "werift": "^0.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^0.9.7",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3"
  }
}
