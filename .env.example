# Runtime / environment
NODE_ENV=development

# Frontend client
VITE_API_BASE_URL=http://localhost:3000
VITE_SOCKET_URL=ws://localhost:3001/ws/realtime
VITE_MODEL_BASE_PATH=/models

# Assistant behavior
SENTINEL_WAKE_WORD=管理员
SENTINEL_WAKE_ACK_FAST_REPLY_ENABLED=1

# Data and model paths
PYTHON_SERVICES_ROOT=data/python_services
PYTHON_SERVICES_SCRIPT_ROOT=src/server/python_services
SENTINEL_DB_DIR=data/db
SENTINEL_MODEL_BASE_PATH=data/models/server-models
VOICE_DATA_ROOT=data/voice

# Optional voice data path overrides used by src/server/services/voice-data-paths.ts.
# COSYVOICE_DATA_ROOT=data/voice/cosyvoice
# VOICE_ASSET_ROOT=data/voice/assets

# Python services
PYTHON_SERVICES_DEVICE=mps
PYTHON_SERVICES_MODE=http
FUNASR_PORT=10101
COSYVOICE_PORT=10102
MDX_PORT=10103
QWEN_VLM_PORT=10104
QWEN_ROUTER_PORT=10105
FUNASR_LOCAL_FILES_ONLY=1
# Override only when the service is not hosted on localhost:FUNASR_PORT.
# FUNASR_BASE_URL=http://localhost:10101

# MLX model services
QWEN_VLM_MODEL_DIR=data/python_services/models_cache/qwen-vlm
QWEN_ROUTER_FAST_MODEL_DIR=data/python_services/models_cache/qwen-router/fast
QWEN_ROUTER_REPAIR_MODEL_DIR=data/python_services/models_cache/qwen-router/repair
QWEN_HF_CACHE_DIR=data/python_services/models_cache/hf-cache
QWEN_HF_HOME_DIR=data/python_services/models_cache/hf-home
QWEN_HF_XET_CACHE_DIR=data/python_services/models_cache/hf-cache/xet
QWEN_VLM_MODEL_ID=qwen3-vl-8b-mlx-4bit
QWEN_ROUTER_FAST_MODEL_ID=qwen2.5-0.5b-instruct-mlx
QWEN_ROUTER_REPAIR_MODEL_ID=qwen2.5-1.5b-instruct-mlx
QWEN_VLM_REPO=mlx-community/Qwen3-VL-8B-Instruct-4bit
QWEN_ROUTER_FAST_REPO=mlx-community/Qwen2.5-0.5B-Instruct-4bit
QWEN_ROUTER_REPAIR_REPO=mlx-community/Qwen2.5-1.5B-Instruct-4bit
QWEN_VLM_TEXT_MAX_TOKENS=512
QWEN_VLM_TEXT_TEMPERATURE=0.2
QWEN_VLM_TEXT_TOP_P=0.9
QWEN_VLM_VISION_MAX_TOKENS=256
QWEN_VLM_VISION_TEMPERATURE=0.1
QWEN_ROUTER_MAX_TOKENS=900
QWEN_ROUTER_REPAIR_WAIT_MS=15000
QWEN_MODEL_SERVICE_TIMEOUT_MS=300000
QWEN_MODEL_WARMUP_ON_START=1
QWEN_HF_OFFLINE=1
QWEN_HF_MAX_WORKERS=1
QWEN_HF_DISABLE_XET=1
QWEN_HF_DOWNLOAD_TIMEOUT=60
QWEN_HF_ETAG_TIMEOUT=30
# Set to 1 only when you want hf-transfer acceleration instead of the resumable standard downloader.
# HF_HUB_ENABLE_HF_TRANSFER=1
# Set to 1 only when setup should fail if Qwen model files are missing.
# QWEN_REQUIRE_MODELS=1
# Set to 1 only when python-services:setup should also install Qwen model service dependencies.
# QWEN_SETUP=1
# Set to 0 only when Qwen model dependencies should install without downloading model files.
# QWEN_DOWNLOAD_MODELS=0
# Set HF_TOKEN or QWEN_HF_TOKEN for faster authenticated Hugging Face downloads.
# QWEN_HF_TOKEN=
# Optional token file read by setup; defaults to ~/.cache/huggingface/token.
# QWEN_HF_TOKEN_FILE=~/.cache/huggingface/token
# Override only when model services are not hosted on localhost:QWEN_*_PORT.
# QWEN_VLM_BASE_URL=http://localhost:10104
# QWEN_ROUTER_BASE_URL=http://localhost:10105

# ASR / voice separation
VOICE_SEPARATION_ENABLED=1
VOICE_SEPARATION_ALLOW_FALLBACK=0
VOICE_SEPARATION_MODEL=UVR-MDX-NET-Inst_HQ_3.onnx
VOICE_SEPARATION_MODEL_PROFILE=balanced
VOICE_SEPARATION_ONNX_PROVIDERS=CoreMLExecutionProvider,CPUExecutionProvider
VOICE_ASR_SEPARATION_MODE=off
VOICE_ASR_SEPARATION_MAX_MS=10000
# Override these only when separation should not reuse PYTHON_SERVICES_ROOT, MDX_PORT, or PYTHON_SERVICES_DEVICE.
# VOICE_SEPARATION_MODEL_DIR=data/python_services/models_cache/mdx
# VOICE_SEPARATION_BASE_URL=http://localhost:10103
# VOICE_SEPARATION_DEVICE=mps

# TTS / CosyVoice
SENTINEL_TTS_PROVIDER=cosyvoice
COSYVOICE_ENDPOINT=/inference_zero_shot
COSYVOICE_MODEL_DIR=data/python_services/models_cache/cosyvoice/Fun-CosyVoice3-0.5B-2512-4bit
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_SPEAKER_ID=
COSYVOICE_SPEAKER_NAME=
COSYVOICE_PROMPT_AUDIO_PATH=
COSYVOICE_PROMPT_TEXT=
COSYVOICE_TIMEOUT_MS=30000
COSYVOICE_FALLBACK_TO_SAY=0
COSYVOICE_TTS_MIN_UNITS=28
COSYVOICE_TTS_MAX_UNITS=60
COSYVOICE_TTS_CLEANUP_ON_CANCEL=1
# Defaults to local Hugging Face cache for mlx_audio's S3TokenizerV3 dependency.
COSYVOICE_HF_OFFLINE=1
# Override only when CosyVoice is not hosted on localhost:COSYVOICE_PORT.
# COSYVOICE_BASE_URL=http://localhost:10102

# CosyVoice Python service audio trimming.
# These are read directly by src/server/python_services/src/cosyvoice_service.py.
COSYVOICE_TRIM_SILENCE=1
COSYVOICE_TRIM_THRESHOLD_DB=-42
COSYVOICE_TRIM_FRAME_MS=10
COSYVOICE_TRIM_HEAD_PAD_MS=50
COSYVOICE_TRIM_TAIL_PAD_MS=110

# External tools
FFMPEG_PATH=ffmpeg
YT_DLP_BIN=data/tools/bin/yt-dlp
YT_DLP_COOKIES_FROM_BROWSER=chrome

# Debug / optional model overrides
SENTINEL_MODEL_TRACE=0
SENTINEL_MODEL_TRACE_MAX_CHARS=4000
