NODE_ENV=development

VITE_API_BASE_URL=http://localhost:3000
VITE_SOCKET_URL=ws://localhost:3001/ws/realtime
VITE_MODEL_BASE_PATH=/models

SENTINEL_DEMO_MODE=full
SENTINEL_WAKE_WORD=管家
SENTINEL_MODEL_TRACE=0
SENTINEL_MODEL_TRACE_MAX_CHARS=4000

PYTHON_SERVICES_ROOT=data/python_services
PYTHON_SERVICES_SCRIPT_ROOT=src/server/python_services
SENTINEL_DB_DIR=data/db
SENTINEL_MODEL_BASE_PATH=data/models/server-models
PYTHON_SERVICES_DEVICE=mps
PYTHON_SERVICES_MODE=http
FUNASR_PORT=10101
COSYVOICE_PORT=10102
MDX_PORT=10103
FUNASR_BASE_URL=http://localhost:10101
VOICE_DATA_ROOT=data/voice

VOICE_SEPARATION_ENABLED=1
VOICE_SEPARATION_PROVIDER=mdx-net
VOICE_SEPARATION_LAZY_START=1
VOICE_SEPARATION_IDLE_TTL_MS=300000
VOICE_SEPARATION_ALLOW_FALLBACK=0
VOICE_SEPARATION_MODEL=UVR-MDX-NET-Inst_HQ_3.onnx
VOICE_SEPARATION_MODEL_PROFILE=balanced
VOICE_SEPARATION_MODEL_DIR=data/python_services/models_cache/mdx
VOICE_SEPARATION_BASE_URL=http://localhost:10103
VOICE_SEPARATION_DEVICE=mps
VOICE_SEPARATION_ONNX_PROVIDERS=CoreMLExecutionProvider,CPUExecutionProvider
VOICE_SEPARATION_MAX_CONCURRENCY=1
VOICE_ASR_SEPARATION_MODE=off
VOICE_ASR_SEPARATION_MAX_MS=10000

SENTINEL_TTS_PROVIDER=cosyvoice
SENTINEL_WAKE_ACK_FAST_REPLY_ENABLED=1
COSYVOICE_BASE_URL=http://localhost:10102
COSYVOICE_ENDPOINT=/inference_zero_shot
COSYVOICE_MODEL_DIR=data/python_services/models_cache/cosyvoice/Fun-CosyVoice3-0.5B-2512-4bit
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_SPEAKER_ID=
COSYVOICE_SPEAKER_NAME=
COSYVOICE_PROMPT_AUDIO_PATH=
COSYVOICE_PROMPT_TEXT=
COSYVOICE_TIMEOUT_MS=30000
COSYVOICE_FALLBACK_TO_SAY=0
COSYVOICE_TTS_MIN_UNITS=28
COSYVOICE_TTS_MAX_UNITS=60
COSYVOICE_TTS_CLEANUP_ON_CANCEL=1
COSYVOICE_TRIM_SILENCE=1
COSYVOICE_TRIM_THRESHOLD_DB=-42
COSYVOICE_TRIM_FRAME_MS=10
COSYVOICE_TRIM_HEAD_PAD_MS=50
COSYVOICE_TRIM_TAIL_PAD_MS=110

FFMPEG_PATH=ffmpeg
YT_DLP_BIN=data/tools/bin/yt-dlp
