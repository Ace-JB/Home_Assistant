NODE_ENV=development

VITE_API_BASE_URL=http://localhost:3000
VITE_SOCKET_URL=ws://localhost:3001/ws/realtime
VITE_MODEL_BASE_PATH=/models

SENTINEL_DEMO_MODE=full
SENTINEL_WAKE_WORD=管家
SENTINEL_MODEL_TRACE=0
SENTINEL_MODEL_TRACE_MAX_CHARS=4000

# Override this when system python3 cannot load torch, e.g.
# FUNASR_CMD="/path/to/venv/bin/python src/server/scripts/funasr_service.py"
FUNASR_CMD=python3 src/server/scripts/funasr_service.py

SENTINEL_TTS_PROVIDER=cosyvoice
COSYVOICE_BASE_URL=http://localhost:50000
COSYVOICE_ENDPOINT=/inference_zero_shot
COSYVOICE_INSTALL_DIR=src/server/models/voice/CosyVoice3-MLX
COSYVOICE_CONDA_ENV=cosyvoice
COSYVOICE_MODEL_DIR=mlx-community/Fun-CosyVoice3-0.5B-2512-4bit
COSYVOICE_MLX_PACKAGE=mlx-audio-plus==0.1.8
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_SPEAKER_ID=
COSYVOICE_SPEAKER_NAME=
COSYVOICE_PROMPT_AUDIO_PATH=
COSYVOICE_PROMPT_TEXT=
COSYVOICE_TIMEOUT_MS=30000
COSYVOICE_FALLBACK_TO_SAY=0

FFMPEG_PATH=ffmpeg
YT_DLP_BIN=src/server/tools/bin/yt-dlp
