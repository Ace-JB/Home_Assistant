{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "react"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["./src/server/*"],
      "@modules/*": ["./src/server/modules/*"],
      "@tools/*": ["./src/server/tools/*"],
      "@db/*": ["./src/server/db/*"]
    },

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  "exclude": [
    "dist",
    "node_modules",
    "data",
    "src/server/models",
    "src/server/models/whisper.cpp",
    "src/server/tools/bin",
    "src/server/db/*.sqlite",
    "src/server/db/*.sqlite-shm",
    "src/server/db/*.sqlite-wal",
    "src/server/python_services/envs",
    "src/server/python_services/models_cache",
    "src/server/python_services/run"
  ]
}
